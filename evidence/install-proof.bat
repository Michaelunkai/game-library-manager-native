orAction SilentlyContinue } else { '' }; if ($dockerRunExitCode -eq 0 -and ([string]$markerContent).Trim() -eq $markerValue) { $runSuccess = $true } else { Write-Warning ('Extraction failed for gunbrella on attempt ' + $attempt + '/3; the completion marker was not written or was invalid.'); if (Test-NativeContainer 'glm-87b8331f439a7c177f6f2994' 'native|gunbrella' $operationId) { & $dockerExecutable container rm --force 'glm-87b8331f439a7c177f6f2994' *> $null; if ($LASTEXITCODE -ne 0) { throw 'Could not remove the native container.' } }; if ($attempt -lt 3) { Start-Sleep -Seconds ([Math]::Min($attempt * 3, 15)) } }
}
