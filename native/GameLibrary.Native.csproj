<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameLibrary</AssemblyName>
    <RootNamespace>GameLibrary.Native</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets/GameLibrary.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>GameLibrary.Native.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Keep WPF native runtime files beside the EXE. Self-extracting them at
         launch writes to the user's TEMP (C:) before managed code can choose
         the F:-resident profile. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/catalog.zip" />
    <EmbeddedResource Include="Assets/catalog.sha256" />
    <Resource Include="Assets/GameLibrary.ico" />
    <Compile Remove="tests/**/*.cs" />
    <!-- gamespeed32.dll compiles cleanly and installs all five hooks, but then faults
         0xC0000005 on a real x86 process, so it is deliberately NOT shipped. Refusing a
         32-bit game is recoverable; crashing it is not. The source and the exact build
         command live in tools\gamespeed\README.md so the work can be resumed. -->
    <None Remove="tools\gamespeed\gamespeed32.dll" />
    <None Update="tools\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="tools\wand-runtime\classic-level\prebuilds\win32-x64\classic-level.node" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
